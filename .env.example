# ─────────────────────────────────────────────────────────────
# mac-multi-server — configuration
# Copy to `.env` and fill in. `.env` is gitignored (never committed).
# Everything the platform needs comes from here — nothing is hardcoded.
# ─────────────────────────────────────────────────────────────

# ── Domain / Cloudflare ──────────────────────────────────────
# Your domain must already be a zone in your Cloudflare account.
DOMAIN=example.com
CLOUDFLARE_API_TOKEN=            # scoped token (see docs/setup.md for exact perms)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=            # the named tunnel that fronts this Mac

# ── Naming ───────────────────────────────────────────────────
# vps{n}.$DOMAIN  → each VPS ;  $PANEL_SUBDOMAIN.$DOMAIN → dashboard
VPS_SUBDOMAIN_PATTERN=vps{n}
PANEL_SUBDOMAIN=panel
GRAFANA_SUBDOMAIN=monitor          # monitoring (Netdata) → monitor.$DOMAIN

# ── New-VPS defaults (overridable per deploy) ────────────────
VPS_DEFAULT_CPU=2
VPS_DEFAULT_MEM_MB=4096
VPS_DEFAULT_DISK_GB=40
VPS_BASE_IMAGE=ghcr.io/cirruslabs/ubuntu:latest
# public key authorized on every new VPS (key-based SSH after first login)
VPS_SSH_PUBKEY=~/.ssh/id_ed25519.pub

# ── Bundles available at deploy time ─────────────────────────
# comma-separated; each maps to a folder in templates/
BUNDLES=blank,openclaw,hermes
# install-script URLs live here so they're easy to fix if a vendor link moves
# (the bundle scripts read these, passed into the guest at deploy time)
OPENCLAW_INSTALL_URL=https://openclaw.ai/install.sh
HERMES_INSTALL_URL=https://hermes-agent.nousresearch.com/install.sh

# ── Control plane (login + dashboard) ────────────────────────
PANEL_ADMIN_USER=admin
PANEL_PORT=8088                     # binds 127.0.0.1 only; exposed via Cloudflare
PANEL_SESSION_SECRET=              # random string for signing sessions (install.sh fills if empty)
PANEL_SSH_JUMP=                    # your Mac's SSH host/alias, shown in the "ssh -J" hint on VPS cards

# ── Internal network (Tart NAT bridge) ───────────────────────
VPS_NET_CIDR=192.168.64.0/24
